{
  "name": "reactive-avatar",
  "productName": "Reactive Avatar",
  "version": "1.0.0",
  "description": "Прозрачный оверлей поверх экрана с персонажем Reactive (реагирует на голос, мут и т.д. в Discord)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip --x64"
  },
  "build": {
    "appId": "dev.kalona.reactive-avatar",
    "productName": "Reactive Avatar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload-settings.js",
      "settings.html",
      "icon.png",
      "tray.png",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
